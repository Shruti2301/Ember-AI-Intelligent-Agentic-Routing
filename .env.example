# Optional: for local development only.
# Production uses bring-your-own-key (BYOK) — visitors add their key in Settings.
#
# Get a key: https://app.fireworks.ai/settings/users/api-keys

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# SAFETY: In production, the server will NOT use FIREWORKS_API_KEY for requests
# that don't carry the visitor's own key (BYOK) — this prevents anonymous
# visitors from spending your key. Local dev still uses it for convenience.
# Only set this to "true" if you intentionally want a shared-key public demo,
# and pair it with rate limiting + a hard spend cap on your Fireworks account.
ALLOW_SHARED_KEY=false
