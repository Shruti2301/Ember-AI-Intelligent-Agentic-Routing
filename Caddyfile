# Replace with your real hostname. Point an A record at the instance's
# Elastic IP first — Caddy fetches a Let's Encrypt cert on startup and will
# fail loudly if DNS doesn't resolve here yet.
emberai.example.com {
	encode zstd gzip
	reverse_proxy ember-ai:3000
}

